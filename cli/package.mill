package build.cli

import mill.*
import mill.javalib.Dep
import mill.scalalib.*
import millbuild.*
import com.carlosedp.aliases.*
import io.github.alexarchambault.millnativeimage.NativeImage

object `package` extends Module {
  trait NativeCliModule extends CommonBuildModule, NativeImage {
    override def mainClass = Some(nativeImageMainClass())

    def nativeImageClassPath = runClasspath()

    def nativeImageGraalVmJvmId = "graalvm-community:25.0.1"

    // The plugin's own version of this task fails on Mill 1.3 with a NoSuchMethodError from
    // Coursier, so let Mill download GraalVM instead. Remove this once the plugin is fixed:
    // https://github.com/alexarchambault/mill-native-image/issues/208
    override def nativeImageGraalvmHome = Task {
      val home = Task.env.get("GRAALVM_HOME").map(os.Path(_)).getOrElse(
        mill.util.Jvm.resolveJavaHome(nativeImageGraalVmJvmId(), Some(Task.ctx())).get,
      )
      PathRef(home, quick = true)
    }

    def nativeImageOptions = Seq(
      "-O3", // Optimized for throughput
      "--no-fallback",
      "--initialize-at-build-time",
      // os.pwd is a val, must not be initialized at build time, or we get bad PWD on runtime.
      // See: https://github.com/com-lihaoyi/os-lib/issues/318
      "--initialize-at-run-time=os.package$",
      "-H:+UnlockExperimentalVMOptions",
      "-H:+RemoveSaturatedTypeFlows",
      "-H:IncludeLocales=en",
      "-H:-GenLoopSafepoints",
      "-H:-ParseRuntimeOptions",
      "-H:-IncludeMethodData",
    ) ++ macosTarget

    // Without this, the minimum macOS version is the one of the build machine.
    private def macosTarget =
      if _root_.scala.util.Properties.isMac then
        Seq("-H:NativeLinkerOption=-mmacosx-version-min=14.0")
      else Seq.empty
  }

  object jvm extends NativeCliModule, CommonModule {
    def nativeImageMainClass = "eu.neverblink.linkml.cli.Main"

    def nativeImageName = "linkml-scala"

    override def mvnDeps = super.mvnDeps() ++ Seq(
      mvn"com.github.alexarchambault::case-app:2.2.0",
    )

    override def moduleDeps = Seq(
      build.generator.jvm,
      build.cli.options.jvm,
    )

    object test extends ScalaTests, CommonTestModule {
      override def moduleDeps = super.moduleDeps :+ build.tests.jvm
    }
  }
}
