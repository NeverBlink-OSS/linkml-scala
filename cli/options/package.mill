package build.cli.options

import mill.*
import mill.scalalib.*
import millbuild.*

/** The command line options of the generators and importers, generated from
  * `model/converter/all_converters.yaml` by `generator.optionsgen`.
  */
object `package` extends Module {
  object jvm extends CommonModule {
    override def mvnDeps = super.mvnDeps() ++ Seq(
      mvn"com.github.alexarchambault::case-app:2.1.1",
    )

    def moduleDeps = Seq(
      build.generator.options.jvm,
      build.yaml.jvm,
    )
  }
}
