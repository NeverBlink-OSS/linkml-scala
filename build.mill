object metamodel extends Module, NativeOptional {
  def regenerate(ev: Evaluator, args: String*): Task.Command[String] =
    Task.Command(exclusive = true) {
      AliasesModule.run(ev, "regenerateMetamodel")
    }

  def definitions = Task(persistent = true) {
    if Task.offline then Task.fail("Can't fetch linkml-model offline")
    val cloneDir = os.temp.dir()
    os.call(
      (
        "git",
        "clone",
        "--depth=1",
        "https://github.com/NeverBlink-OSS/linkml-model",
      ),
      cwd = cloneDir,
    )
    os.copy.over(cloneDir / "linkml-model" / "linkml_model" / "model" / "schema", Task.dest)
    PathRef(Task.dest)
  }

  /** The version of the LinkML metamodel we build against, so it can be reported at runtime.
    */
  def metamodelVersion = Task {
    val meta = os.read(definitions().path / "meta.yaml")
    raw"(?m)^metamodel_version:\s*(\S+)\s*$$".r.findFirstMatchIn(meta) match {
      case Some(m) => m.group(1)
      case None => Task.fail("meta.yaml has no metamodel_version")
    }
  }

  object jvm extends CommonModule, ResourcesAsStrings("metamodel") {
    def moduleDeps = Seq(
      build.yaml.jvm,
    )

    override def resources: T[Seq[PathRef]] = {
      super.resources() :+ definitions()
    }

    object test extends ScalaTests, CommonTestModule {
      override def mvnDeps = super.mvnDeps() ++ Seq(
        mvn"io.circe::circe-core::0.14.16",
      )
    }
  }

  object js extends NoBspModule, CommonScalaJSModule, ResourcesAsStrings("metamodel") {
    def moduleDeps = Seq(
      build.yaml.js,
    )

    override def resources: T[Seq[PathRef]] = {
      super.resources() :+ definitions()
    }

    object test extends ScalaJSTests, CommonTestModule {
      override def mvnDeps = super.mvnDeps() ++ Seq(
        mvn"io.circe::circe-core::0.14.16",
      )
    }
  }

  object native extends NoBspModule, CommonScalaNativeModule, ResourcesAsStrings("metamodel") {
    def moduleDeps = Seq(
      build.yaml.native,
    )

    override def resources: T[Seq[PathRef]] = {
      super.resources() :+ definitions()
    }

    object test extends ScalaNativeTests, CommonTestModule {
      override def mvnDeps = super.mvnDeps() ++ Seq(
        mvn"io.circe::circe-core::0.14.16",
      )
    }
  }
}

/** The LinkML validation report model, generated into Scala by this project's own Scala generator.
  *
  * @note
  *   The sources are checked in, because regenerating them needs `cli`, which transitively depends
  *   on this module. If they ever stop compiling, revert them before running
  *   `validation.regenerate`.
  */
object validation extends Module, NativeOptional {
  def regenerate(ev: Evaluator, args: String*): Task.Command[String] =
    Task.Command(exclusive = true) {
      AliasesModule.run(ev, "regenerateValidation")
    }

  object jvm extends CommonModule {
