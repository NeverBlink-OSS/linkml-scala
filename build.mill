/** Whether to compile and test Scala Native in this run.
  *
  * This is disabled by default, because Scala Native has a pretty complex and slow toolchain. To
  * run it locally: `LINKML_NATIVE=1 ./mill --no-server runtime.native.test.testForked`
  */
val nativeEnabled: Boolean =
  sys.env.get("LINKML_NATIVE").exists(v => v == "1" || v.equalsIgnoreCase("true"))

object LinkMlAliases extends Aliases {
  def lint: Seq[String] = {
    val platforms = Seq("__.jvm.__", "__.js.__") ++ Option.when(nativeEnabled)("__.native.__")
    alias(platforms.flatMap(p => Seq(s"$p.fix", s"$p.reformat"))*)
  }

  def regenerateMetamodel: Seq[String] = alias(
    "cli.jvm.run generate scala --to metamodel/src/eu/neverblink/linkml/metamodel/ linkml:meta",
    "metamodel.jvm.fix",
    "metamodel.jvm.reformat",
  )

  def regenerateValidation: Seq[String] = alias(
    "cli.jvm.run generate scala --to validation/src/eu/neverblink/linkml/validation/ " +
      "--package eu.neverblink.linkml.validation model/issue-types.yaml",
    "validation.jvm.fix",
    "validation.jvm.reformat",
  )

  def regenerateBuildInfo: Seq[String] = alias(
    "cli.jvm.run generate scala --to schemaview/src/eu/neverblink/linkml/schemaview/buildinfo/ " +
      "--package eu.neverblink.linkml.schemaview.buildinfo model/build-info.yaml",
    "schemaview.jvm.fix",
    "schemaview.jvm.reformat",
  )
}

def lint(ev: Evaluator, args: String*) = Task.Command(exclusive = true) {
  AliasesModule.run(ev, "lint")
}

/** Bundle the TypeScript playground UI (app.ts + CodeMirror, plus the generation worker) into
  * ui/dist via esbuild. Installs npm deps on first run. Requires Node.js and npm on the PATH.
  */
def buildUiBundle(): Unit = {
  val uiDir = mill.api.BuildCtx.workspaceRoot / "ui"
  if (!os.exists(uiDir / "node_modules"))
    os.call(("npm", "ci"), cwd = uiDir, stdout = os.Inherit, stderr = os.Inherit)
  os.call(("npm", "run", "build"), cwd = uiDir, stdout = os.Inherit, stderr = os.Inherit)
}

def uiBundle(args: String*) = Task.Command(exclusive = true) {
  buildUiBundle()
}

/** Regenerate ui/linkml.d.ts (the LinkML API types the UI is checked against) from the Scala
  * facade. Run after changing LinkMlJsApi.scala.
  */
def uiTypes(args: String*) = Task.Command(exclusive = true) {
  os.copy.over(generator.js.tsDefs().path, mill.api.BuildCtx.workspaceRoot / "ui" / "linkml.d.ts")
}

/** Type-check the UI against the LinkML types and confirm it bundles. Requires Node.js and npm on
  * the PATH.
  */
def uiCheck(args: String*) = Task.Command(exclusive = true) {
  val uiDir = mill.api.BuildCtx.workspaceRoot / "ui"
  if (!os.exists(uiDir / "node_modules"))
    os.call(("npm", "ci"), cwd = uiDir, stdout = os.Inherit, stderr = os.Inherit)
  os.call(("npm", "run", "typecheck"), cwd = uiDir, stdout = os.Inherit, stderr = os.Inherit)
  os.call(("npm", "run", "build"), cwd = uiDir, stdout = os.Inherit, stderr = os.Inherit)
}

def ui(args: String*) = Task.Command() {
  generator.js.fullLinkJS()
  buildUiBundle()
  val server =
    SimpleFileServer.createFileServer(
      new InetSocketAddress(8000),
      mill.api.BuildCtx.workspaceRoot.toNIO,
      SimpleFileServer.OutputLevel.INFO,
    )

  try {
    server.start()
    println("\nBrowser UI up at http://localhost:8000/ui/\n")
    Thread.sleep(Long.MaxValue)
  } finally {
    server.stop(0)
  }
}

