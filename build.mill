//| mill-version: 1.1.6
//| mvnDeps:
//| - com.goyeau::mill-scalafix::0.6.0
//| - ch.epfl.scala:scalafix-interfaces:0.14.6
//| - io.github.alexarchambault.mill::mill-native-image::0.2.6
//| - com.lihaoyi::mill-contrib-scoverage:$MILL_VERSION
//| - com.lihaoyi::mill-contrib-jmh:$MILL_VERSION
//| - com.carlosedp::mill-aliases::1.1.0
//| - org.scalameta::scalameta:4.13.4
//| - com.lihaoyi::mill-contrib-buildinfo:$MILL_VERSION
//| bspScriptIgnore: [".idea/**"]
//| mill-jvm-opts: ["-Xss256m", "-Xmx10G"]

package build

import com.goyeau.mill.scalafix.ScalafixModule
import mill.*
import mill.contrib.jmh.JmhModule
import mill.contrib.scoverage.*
import mill.javalib.publish.*
import mill.scalalib.scalafmt.ScalafmtModule
import mill.scalajslib.*
import mill.scalajslib.api.ModuleKind
import scalalib.*
import scalanativelib.*
import mill.scalanativelib.api.{BuildTarget, LTO, ReleaseMode}
import io.github.alexarchambault.millnativeimage.NativeImage
import com.carlosedp.aliases.*
import mill.contrib.buildinfo.BuildInfo
import mill.api.Evaluator
import mill.javalib.Dep
import millbuild.*

import java.net.InetSocketAddress

object `package` extends Module {

  /** Whether to compile and test Scala Native in this run.
    *
    * This is disabled by default, because Scala Native has a pretty complex and slow toolchain. To
    * run it locally: `LINKML_NATIVE=1 ./mill --no-server runtime.native.test.testForked`
    */

  object LinkMlAliases extends Aliases {
    private def ohiGeneration: Seq[String] = {
      val schemas = Seq(
        ("package", "generated", "generated"),
        ("search-request", "generated.searchrequest", "generated_search_request"),
        ("search", "generated.search", "generated_search"),
        ("catalog-config", "generated.config", "generated_config"),
        ("catalog-error", "generated.error", "generated_error"),
        ("lock", "generated.lock", "generated_lock"),
        ("lock-error", "generated.lockerror", "generated_lock_error"),
      )
      schemas.flatMap { case (name, scalaPackage, module) =>
        val schema = s"ohi/model/schema/$name.yaml"
        Seq(
          s"cli.jvm.run validate $schema",
          "cli.jvm.run generate scala --clean " +
            s"--to ohi/model/src/eu/neverblink/ohi/model/${scalaPackage.replace('.', '/')}/ " +
            s"--package eu.neverblink.ohi.model.$scalaPackage $schema",
          s"cli.jvm.run generate pydantic --to ohi/python/src/ohi/$module.py $schema",
          s"cli.jvm.run generate typescript --to ohi/typescript/src/$module.ts $schema",
        ) ++ Option.when(!name.endsWith("-error"))(
          s"cli.jvm.run generate json-schema --to ohi/model/resources/$name.schema.json $schema",
        )
      } ++ Seq(
        "cli-delivery" -> "delivery",
        "cli-file-error" -> "fileerror",
        "cli-lock-download" -> "lockdownload",
        "declaration" -> "declaration",
        "project-result" -> "projectresult",
        "project-error" -> "projecterror",
      ).flatMap { case (name, scalaPackage) =>
        val schema = s"cli/ohi/schema/$name.yaml"
        Seq(
          s"cli.jvm.run validate $schema",
          "cli.jvm.run generate scala --clean " +
            s"--to cli/ohi/src/eu/neverblink/ohi/cli/generated/$scalaPackage/ " +
            s"--package eu.neverblink.ohi.cli.generated.$scalaPackage $schema",
        ) ++ (if (name == "declaration") Seq(
                s"cli.jvm.run generate json-schema --to cli/ohi/resources/$name.schema.json $schema",
                "pruneOhiDeclaration",
              )
              else Seq.empty)
      } ++ Seq(
        "ohi.model.jvm.fix",
        "ohi.model.jvm.reformat",
        "cli.ohi.jvm.fix",
        "cli.ohi.jvm.reformat",
      )
    }

    def regenerateOhi: Seq[String] = alias(ohiGeneration*)

    def lint: Seq[String] = {
      val platforms =
        Seq("__.jvm.__", "__.js.__") ++ Option.when(NativeOptional.nativeEnabled)("__.native.__")
      alias((platforms :+ "agents.__").flatMap(p => Seq(s"$p.fix", s"$p.reformat"))*)
    }

    /** Regenerate every checked-in source generated from a LinkML model. */
    def regenerate: Seq[String] = alias((Seq(
      "__:LinkMlModelModule.regenerate",
      "__:LinkMlModelModule.jvm.fix",
      "__:LinkMlModelModule.jvm.reformat",
      "agents.generate",
    ) ++ ohiGeneration)*)

    def regenerateBindings: Seq[String] = alias(
      "nativelib.generateBindings",
      "nativelib.native.fix",
      "nativelib.native.reformat",
    )
  }

  def lint(ev: Evaluator, args: String*) = Task.Command(exclusive = true) {
    AliasesModule.run(ev, "lint")
  }

  def regenerate(ev: Evaluator, args: String*) = Task.Command(exclusive = true) {
    AliasesModule.run(ev, "regenerate")
  }

  def regenerateOhi(ev: Evaluator, args: String*) = Task.Command(exclusive = true) {
    AliasesModule.run(ev, "regenerateOhi")
  }

  /** Remove the unused Format enum imported through selection. Both generators retain imported
    * enums even when no declaration field uses them.
    */
  def pruneOhiDeclaration() = Task.Command {
    val root = mill.api.BuildCtx.workspaceRoot / "cli" / "ohi"
    os.remove(root / os.SubPath("src/eu/neverblink/ohi/cli/generated/declaration/Format.scala"))
    val path = root / "resources" / "declaration.schema.json"
    val schema = ujson.read(os.read(path))
    schema("$defs").obj.remove("Format")
    os.write.over(path, ujson.write(schema, indent = 2) + "\n")
  }

  /** Generates the derived files of the agent skills in `.agents/`, and checks the skills. Not
    * published.
    */
  object agents extends ScalaModule, ScalafmtModule, ScalafixModule {
    override def moduleDir = super.moduleDir / os.up / ".agents"

    def scalaVersion = Version.scala

    def scalacOptions = Seq("-Wunused:all")

    def moduleDeps = Seq(build.schemaview.jvm)

    override def mvnDeps = Seq(mvn"com.lihaoyi::os-lib:0.11.8")

    def generate() = Task.Command {
      runner().run(Seq(mill.api.BuildCtx.workspaceRoot.toString))
    }

    object test extends ScalaTests, CommonTestModule {
      override def mvnDeps = super.mvnDeps() ++ Seq(mvn"com.lihaoyi::ujson:4.4.3")
    }
  }

  /** A JDK 25, for the test modules that pull in RDF4J 6.x.
    */
  object jdk25 extends JavaHomeModule {
    override def jvmVersion = "25"
  }

  // Global coverage reporting
  object coverage extends ScoverageReport {
    override def scalaVersion = Version.scala

    override def scoverageVersion = "2.5.2"
  }
}
