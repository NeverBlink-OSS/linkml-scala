}

object schemaview extends Module, NativeOptional {
  def regenerate(ev: Evaluator, args: String*): Task.Command[String] =
    Task.Command(exclusive = true) {
      AliasesModule.run(ev, "regenerateBuildInfo")
    }

  object jvm extends SchemaViewModule {
    def moduleDeps = Seq(
      build.metamodel.jvm,
      build.validation.jvm,
    )

    object test extends ScalaTests, CommonTestModule
  }

  object js extends SchemaViewModule, NoBspModule, CommonScalaJSModule {
    def moduleDeps = Seq(
      build.metamodel.js,
      build.validation.js,
    )

    object test extends ScalaJSTests, CommonTestModule
  }

  object native extends SchemaViewModule, NoBspModule, CommonScalaNativeModule {
    def moduleDeps = Seq(
      build.metamodel.native,
      build.validation.native,
    )

    object test extends ScalaNativeTests, CommonTestModule
  }

  trait SchemaViewModule extends CommonModule, BuildInfo {
    def mvnDeps = Seq(
      mvn"com.lihaoyi::fastparse::3.1.1",
    )

    def buildInfoPackageName = "eu.neverblink.linkml.schemaview.buildinfo"

    // `BuildInfo` is the LinkML-generated class in that package, so the constants need another name.
    override def buildInfoObjectName = "BuildConstants"

    // Compile the values into the class file instead of reading them from a properties resource.
    // Scala.js has no resources at all, and on the JVM side the native image would otherwise need
    // the properties file registered by hand.
    override def buildInfoStaticCompiled = true

    def buildInfoMembers = Seq(
      BuildInfo.Value("version", publishVersion()),
      BuildInfo.Value("scalaVersion", scalaVersion()),
      BuildInfo.Value("scalaJsVersion", scalaJS),
      BuildInfo.Value("metamodelVersion", build.metamodel.metamodelVersion()),
    )

    // fastparse's `rep`/`StringIn` macros trip -Xcheck-macros ("Expression created in a splice was
    // used outside of that splice") on Scala 3.8. The generated parsers are correct -- it's a
    // scope-tracking bug in fastparse's quotes, fixed upstream but unreleased (3.1.1 is latest).
    // Scoped to this module so the rest of the build keeps the check.
    override def scalacOptions = super.scalacOptions().filterNot(_ == "-Xcheck-macros")
  }
}

/** A JDK 25, for the test modules that pull in RDF4J 6.x.
  */
object jdk25 extends JavaHomeModule {
  override def jvmVersion = "25"
}

object generator extends Module, NativeOptional {
  object jvm extends CommonModule, GeneratorDeps {
    override def mvnDeps = super.mvnDeps() ++ Seq(
      mvn"com.lihaoyi::os-lib:0.11.8",
    )

    def moduleDeps = Seq(
      build.schemaview.jvm,
    )

    // Tests parse the generated RDF back and cross-validate it with rdf4j-shacl, so they compile
    // and run on JDK 25.
    object test extends ScalaTests, CommonTestModule {
      override def jvmVersion = "25"

      override def javaHome = build.jdk25.javaHome

      override def moduleDeps = super.moduleDeps ++ Seq(build.tests.jvm, build.cli.jvm)

      override def mvnDeps = super.mvnDeps() ++ Seq(
        mvn"org.eclipse.rdf4j:rdf4j-shacl:$rdf4j",
        mvn"com.softwaremill.sttp.apispec::jsonschema-circe::0.11.10",
        mvn"com.networknt:json-schema-validator:3.0.7",
        mvn"org.sangria-graphql::sangria:4.2.19",
        mvn"org.scala-lang::scala3-compiler:$scala",
      )

      /** Fetch the linkml-benchmark-schemas datasets used by `BenchmarkSchemaSpec`.
        */
      def benchmarkSchemas = Task(persistent = true) {
        if Task.offline then Task.fail("Can't fetch linkml-benchmark-schemas offline")
        val cloneDir = os.temp.dir()
        os.call(
          (
            "git",
            "clone",
            "--depth=1",
            "https://github.com/NeverBlink-labs/linkml-benchmark-schemas",
          ),
          cwd = cloneDir,
        )
        os.copy.over(cloneDir / "linkml-benchmark-schemas" / "benchmark_data", Task.dest)
        PathRef(Task.dest)
      }

      /** The npm project whose `validate.mjs` checks the generated ER diagrams against the real
        * Mermaid parser, used by `ErDiagramMermaidSpec`.
        */
      def mermaidDir = mill.api.BuildCtx.workspaceRoot / "generator" / "test" / "mermaid"

      /** Install the pinned Mermaid that `ErDiagramMermaidSpec` validates its output against.
        * Requires Node.js 18+ and npm on the PATH.
        */
      def mermaidValidator(args: String*) = Task.Command(exclusive = true) {
        if !os.exists(mermaidDir / "node_modules") then
          os.call(("npm", "ci"), cwd = mermaidDir, stdout = os.Inherit, stderr = os.Inherit)
      }

      // Point BenchmarkSchemaSpec at the fetched datasets, so they are cloned before the tests run,
      // and ErDiagramMermaidSpec at the Mermaid install prepared by `mermaidValidator`.
      override def forkEnv = super.forkEnv() ++ Map(
        "LINKML_BENCHMARK_SCHEMAS" -> benchmarkSchemas().path.toString,
        "LINKML_MERMAID_VALIDATOR" -> mermaidDir.toString,
      ) ++
        sys.env.view.filterKeys(Set("PATH", "CI")).toMap
    }
  }

  object js extends NoBspModule, CommonScalaJSModule, GeneratorDeps {
    def moduleDeps = Seq(
      build.schemaview.js,
    )

    // README and the TS usage sample; the .d.ts itself is generated.
    def npmMetadata = Task.Source(mill.api.BuildCtx.workspaceRoot / "generator" / "npm")

    def jsApiSource = Task.Source(
      mill.api.BuildCtx.workspaceRoot /
        "generator" / "src-js" / "eu" / "neverblink" / "linkml" / "js" / "LinkMlJsApi.scala",
    )

    def tsDefs = Task {
      val out = Task.dest / "index.d.ts"
      os.write(out, TsDefsGen(os.read(jsApiSource().path)))
      PathRef(out)
    }

    /** Assemble the npm-publishable `@neverblink/linkml` package. */
    def npmPackage = Task {
      val report = fullLinkJS()
      val dest = Task.dest
      val mainFile = report.publicModules.head.jsFileName

      os.list(report.dest.path)
        .filter(p => p.ext == "js" || p.ext == "map")
        .foreach(p => os.copy.into(p, dest))
      os.copy.into(npmMetadata().path / "README.md", dest)
      os.copy.into(tsDefs().path, dest)
      os.write(
        dest / "package.json",
        NpmPackage.packageJson(publishVersion(), pomSettings().description, mainFile),
      )
      PathRef(dest)
    }

    /** Pack and install the package, then run the README examples and type-check the usage sample
      * against it. Requires Node.js and npm on the PATH.
      */
    def verifyPackage(args: String*) = Task.Command {
      val pkg = npmPackage().path
      val script = npmMetadata().path / "verify-package.mjs"
      val usageSample = npmMetadata().path / "usage.test.ts"
      os.call(
        ("node", script.toString, pkg.toString, usageSample.toString),
        stdout = os.Inherit,
        stderr = os.Inherit,
      )
      ()
    }

    object test extends ScalaJSTests, CommonTestModule {
      override def moduleDeps = super.moduleDeps :+ build.tests.js

      override def mvnDeps = super.mvnDeps() ++ Seq(
        mvn"com.softwaremill.sttp.apispec::jsonschema-circe::0.11.10",
      )
    }
  }

  object native extends NoBspModule, CommonScalaNativeModule, GeneratorDeps {
    def moduleDeps = Seq(
      build.schemaview.native,
    )

    object test extends ScalaNativeTests, CommonTestModule {
      override def moduleDeps = super.moduleDeps :+ build.tests.native

      override def mvnDeps = super.mvnDeps() ++ Seq(
        mvn"com.softwaremill.sttp.apispec::jsonschema-circe::0.11.10",
      )
    }
  }

  trait GeneratorDeps extends CommonModule {
    override def mvnDeps = super.mvnDeps() ++ Seq(
      mvn"com.softwaremill.sttp.apispec::apispec-model::0.11.10",
      mvn"com.github.plokhotnyuk.jsoniter-scala::jsoniter-scala-macros::2.40.1",
    )
  }
}

object cli extends Module {
  object jvm extends CommonModule, NativeImage {
    override def mainClass = Some(nativeImageMainClass())

    def nativeImageMainClass = "eu.neverblink.linkml.cli.Main"

    def nativeImageName = "linkml-scala"

    def nativeImageClassPath = runClasspath()

    def nativeImageGraalVmJvmId = "graalvm-oracle:25"

    def nativeImageOptions = Seq(
      "-O3", // Optimized for throughput
      "--no-fallback",
      "--initialize-at-build-time",
      // os.pwd is a val, must not be initialized at build time, or we get bad PWD on runtime.
      // See: https://github.com/com-lihaoyi/os-lib/issues/318
      "--initialize-at-run-time=os.package$",
      "-H:+UnlockExperimentalVMOptions",
      "-H:+RemoveSaturatedTypeFlows",
      "-H:+MLCallCountProfileInference",
      "-H:IncludeLocales=en",
      "-H:-GenLoopSafepoints",
      "-H:-ParseRuntimeOptions",
      "-H:-IncludeMethodData",
    )

    override def mvnDeps = super.mvnDeps() ++ Seq(
      mvn"com.github.alexarchambault::case-app:2.1.0",
    )

    override def moduleDeps = Seq(
      build.generator.jvm,
    )

    object test extends ScalaTests, CommonTestModule {
      override def moduleDeps = super.moduleDeps :+ build.tests.jvm
    }
  }
}

/** Regenerate the C and Python bindings from mill-build/src/Entrypoints.scala and each generator's
  * `Options` case class. Run after adding a generator or an option.
  */
def bindings(args: String*) = Task.Command(exclusive = true) {
  val root = mill.api.BuildCtx.workspaceRoot
  def read(path: String): String = os.read(root / os.RelPath(path))
  os.write.over(root / "python" / "linkml_scala" / "_generated.py", PyBindingsGen(read))
  os.write.over(
    root / "nativelib" / "src" / "eu" / "neverblink" / "linkml" / "nativelib" /
      "LinkMlCGenerators.scala",
    CApiGen(read),
  )
}

/** LinkML as a native shared library with a C ABI, and the Python bindings on top of it.
  *
  * Built with Scala Native. The CLI executable is still a GraalVM native image, see `cli`.
  *
  * Hidden unless `LINKML_NATIVE=1`, like every other Scala Native module.
  */
object nativelib extends Module, NativeOptional {
  object native extends ScalaNativeModule, ScalafmtModule, ScalafixModule {
    override def moduleDir = super.moduleDir / os.up

    def scalaVersion = scala

    def scalaNativeVersion = scalaNative

    def moduleDeps = Seq(build.generator.native)

    def scalacOptions = Seq("-Wunused:all")

    override def nativeBuildTarget = BuildTarget.LibraryDynamic

    /** The Python bindings drive the library from one dedicated thread, which is the only
      * arrangement Scala Native supports for a library another runtime loads. Multithreading
      * support would only cost us safepoint checks we never benefit from.
      */
    override def nativeMultithreading = Task { Some(false) }

    /** `release-fast`, not `release-full`: 4.5% faster for +42% size, double the start-up and a
      * 39-second link. LTO is left off because it breaks exception handling in a library build.
      * See docs/python_bindings.md.
      */
    override def releaseMode = Task { ReleaseMode.ReleaseFast }

    /** Set to an LLVM triple to generate code for another platform. */
    override def nativeTarget = Task.Input { Task.env.get("LINKML_SCALA_TARGET") }

    /** Scala Native names the library after its own output file, so the install name has to be
      * corrected or the loader goes looking for `libout.so`. The last one on the command line wins.
      */
    override def nativeLinkingOptions = Task {
      val library = NativeLib.name + platformLibraryExtension
      val rename =
        if _root_.scala.util.Properties.isMac then Seq(s"-Wl,-install_name,@rpath/$library")
        else if _root_.scala.util.Properties.isWin then Seq.empty
        else Seq(s"-Wl,-soname,$library")
      super.nativeLinkingOptions() ++ rename
    }

    /** `liblinkml_scala.so` and the header, named the way the Python bindings and `package.sh`
      * expect.
      *
      * Everything the linker emitted alongside the library comes too, renamed to match: on Windows
      * that is the `.lib` import library, without which nothing can link against the DLL.
      */
    def sharedLibrary = Task {
      val built = nativeLink().path
      val stem = built.baseName
      // Reading another task's output directory, which is what the checker is there to stop. The
      // linker names its side outputs after the library rather than declaring them, so there is
      // nothing to ask for by name. `out.exp` on Windows is left behind: it is a linker
      // intermediate, and nothing downstream wants it.
      mill.api.BuildCtx.withFilesystemCheckerDisabled {
        Seq(built / os.up, nativeWorkdir())
          .filter(os.exists)
          .flatMap(os.list(_))
          .filter(path =>
            os.isFile(path) && path.baseName == stem &&
              Set("so", "dylib", "dll", "lib").contains(path.ext),
          )
          .foreach(path => os.copy.over(path, Task.dest / (NativeLib.name + "." + path.ext)))
      }
      os.copy.over(headerSource().path, Task.dest / "linkml_scala.h")
      PathRef(Task.dest)
    }

    private def platformLibraryExtension =
      if _root_.scala.util.Properties.isWin then ".dll"
      else if _root_.scala.util.Properties.isMac then ".dylib"
      else ".so"

    /** Hand-written, because Scala Native generates no header for its exports. */
    def headerSource =
      Task.Source(mill.api.BuildCtx.workspaceRoot / "nativelib" / "include" / "linkml_scala.h")

    // Python bindings

    /** The Python package: the sources, packaging metadata and tests. */
    def pythonDir = Task.Source(mill.api.BuildCtx.workspaceRoot / "python")

    def licenseFile = Task.Source(mill.api.BuildCtx.workspaceRoot / "LICENSE")

    /** Where the Python package looks for the library when it is not told otherwise. */
    private def pythonLibDir = mill.api.BuildCtx.workspaceRoot / "python" / "linkml_scala" / "_lib"

    /** Build the library and install it into the Python package, so `import linkml_scala` works
      * from a source checkout.
      */
    def installPythonLib() = Task.Command(exclusive = true) {
      Python.installLibrary(sharedLibrary().path, pythonLibDir)
      println(s"Installed the shared library into ${pythonLibDir.relativeTo(
          mill.api.BuildCtx.workspaceRoot,
        )}")
    }

    /** Run the Python binding's test suite against a freshly installed library. Requires Python
      * 3.10+ on the PATH, or `PYTHON` pointing at one.
      */
    def pythonTest(args: String*) = Task.Command(exclusive = true) {
      installPythonLib()()
      Python.runTests(mill.api.BuildCtx.workspaceRoot)
    }

    /** Build the `neverblink-linkml` wheel for this platform. */
    def pythonWheel = Task {
      PathRef(
        Python.buildWheel(
          Task.dest,
          sharedLibrary().path,
          pythonDir().path,
          licenseFile().path,
          wheelVersion(),
        ),
      )
    }

    def wheelVersion = Task { PyPackage.version(build.generator.jvm.publishVersion()) }

    /** Build the wheel, install it into a throwaway virtualenv and check the installed package
      * works, from a temporary directory so the import cannot come from `python/`.
      */
    def pythonWheelTest(args: String*) = Task.Command(exclusive = true) {
      Python.testWheel(
        Task.dest,
        pythonWheel().path,
        pythonDir().path,
        mill.api.BuildCtx.workspaceRoot,
      )
    }

    // The source distribution
    //
    // It carries Scala Native IR rather than a compiled library, plus Scala Native's linker, and
    // links on the machine doing the install. That is what makes it installable on any platform
    // Scala Native supports rather than only the ones we build wheels for.

    /** Scala Native's linker, as a standalone tool. */
    def linkerClasspath = Task {
      defaultResolver().classpath(Seq(mvn"org.scala-native::scala-native-cli:$scalaNative"))
    }

    /** Every jar the linker needs. `transitiveJars` is upstream only, so this module's own jar has
      * to be added by hand.
      */
    def nirJars = Task { (transitiveJars() :+ jar()) ++ resolvedMvnDeps() }

    /** Lay out the source distribution. No compiled library goes in; `python/hatch_build.py` links
      * one during `pip install`.
      */
    def sdistTree = Task {
      val dest = Task.dest
      val source = pythonDir().path
      os.copy.over(source / "pyproject.toml", dest / "pyproject.toml", createFolders = true)
      os.copy.over(source / "hatch_build.py", dest / "hatch_build.py")
      os.copy.over(source / "README.md", dest / "README.md")
      os.copy.over(licenseFile().path, dest / "LICENSE")
      os.copy.over(source / "linkml_scala", dest / "linkml_scala")
      os.remove.all(dest / "linkml_scala" / "_lib")
      os.write.over(dest / "linkml_scala" / "_version.py", PyPackage.versionFile(wheelVersion()))

      def stage(jars: Seq[PathRef], into: os.Path): Unit = {
        os.makeDir.all(into)
        jars.map(_.path).foreach { jar =>
          // Dependency jars are uniquely named; ours are all `out.jar`, so name those by module.
          val name =
            if jar.last == "out.jar" then
              jar.segments.toSeq.dropRight(2).takeRight(2).mkString("-") + ".jar"
            else jar.last
          os.copy.over(jar, into / name)
        }
      }
      stage(nirJars(), dest / "_native" / "nir")
      stage(linkerClasspath(), dest / "_native" / "linker")
      PathRef(dest)
    }

    /** Build the source distribution. Requires Python with `build` installed. */
    def sdist = Task {
      os.call(
        (sys.env.getOrElse("PYTHON", "python3"), "-m", "build", "--sdist", "--outdir", Task.dest,
          sdistTree().path),
        stdout = os.Inherit,
        stderr = os.Inherit,
      )
      PathRef(Task.dest)
    }

    /** Install the source distribution into a throwaway virtualenv, which links the library on the
      * way in, and run the test suite against the result.
      */
    def sdistTest(args: String*) = Task.Command(exclusive = true) {
      Python.testSdist(
        Task.dest,
        os.list(sdist().path).find(_.ext == "gz").getOrElse(Task.fail("no sdist was produced")),
        mill.api.BuildCtx.workspaceRoot,
      )
    }
  }
}

/** JMH benchmarks for the code generators. JVM-only, not published. Run with:
  * `./mill benchmark.runJmh`
  */
object benchmark extends ScalaModule, ScalafmtModule, ScalafixModule, JmhModule {
  def scalaVersion = scala

  // JMH forks a JVM using this runtime
  override def jvmVersion = "temurin:25"

  def jmhCoreVersion = "1.37"

  def moduleDeps = Seq(
    build.cli.jvm,
  )

  // RDF4J Rio and Jena ARQ/RIOT, to compare against in the streaming-serializer benchmark.
  override def mvnDeps = super.mvnDeps() ++ Seq(
    mvn"dev.zio::zio-blocks-schema-yaml::0.0.51",
    mvn"org.eclipse.rdf4j:rdf4j-rio-ntriples:$rdf4j",
    mvn"org.eclipse.rdf4j:rdf4j-rio-turtle:$rdf4j",
    mvn"org.apache.jena:jena-arq:6.2.0",
  )

  def scalacOptions = Seq(
    "-release",
    "17",
  )
}

object tests extends Module, NativeOptional {
  object jvm extends ResourcesAsStrings("tests"), CommonModule, CommonTestModule {
    def moduleDeps = Seq(
      build.schemaview.jvm,
    )
  }

  object js
      extends NoBspModule,
        ResourcesAsStrings("tests"),
        CommonScalaJSModule,
        TestScalaJSModule,
        CommonTestModule {
    def moduleDeps = Seq(
      build.schemaview.js,
    )
  }

  object native
      extends NoBspModule,
        ResourcesAsStrings("tests"),
        CommonScalaNativeModule,
        TestScalaNativeModule,
        CommonTestModule {
    def moduleDeps = Seq(
      build.schemaview.native,
    )
  }
}

trait CommonModule
    extends ScalaModule,
      PublishModule,
      PlatformScalaModule,
      ScalafixModule,
      ScalafmtModule,
      ScoverageModule {
  def jvmVersion = "17"

  final def scoverageVersion = "2.5.2"

  final def pomSettings = PomSettings(
    description =
      "A Scala 3 cross-platform library and CLI for LinkML schema validation and multi-format code generation (Scala, JSON Schema, SHACL, RDFS)",
    organization = "eu.neverblink.linkml",
    url = "https://github.com/NeverBlink-OSS/linkml-scala",
    licenses = Seq(License.`Apache-2.0`),
    versionControl = VersionControl.github("NeverBlink-OSS", "linkml-scala"),
    Seq(
      Developer(
        id = "NeverBlink",
        name = "NeverBlink",
        url = "https://neverblink.eu",
        organization = Some("NeverBlink"),
        organizationUrl = Some("https://neverblink.eu"),
      ),
    ),
  )

  final def publishVersion = Task {
    // On a tag build, use the tag that triggered the release rather than
    // `git describe`, which is ambiguous when several v* tags point at the same
    // commit and can otherwise publish the wrong version.
    val tagVersion =
      if sys.env.get("GITHUB_REF_TYPE").contains("tag") then
        sys.env.get("GITHUB_REF_NAME").filter(_.startsWith("v")).map(_.stripPrefix("v"))
      else None
    tagVersion.getOrElse(describeVersion())
  }

  private def describeVersion(): String =
    try describeVersionUnsafe()
    catch {
      // No tags, shallow clone or not a git checkout
      case _: os.SubprocessException => "0.0.0-SNAPSHOT"
    }

  private def describeVersionUnsafe(): String = {
    val gitOutput = os.proc("git", "describe", "--tags", "--long", "--match", "v*")
      .call(cwd = mill.api.BuildCtx.workspaceRoot, stderr = os.Pipe)
      .out
      .trim()
    val GitDescribeRegex = """v(.*)-(\d+)-g([0-9a-fA-F]+)""".r
    gitOutput match {
      case GitDescribeRegex(tag, commitCount, shortHash) =>
        if (commitCount == "0") tag
        else {
          val targetCommit = os.proc("git", "rev-parse", s"HEAD~$commitCount")
            .call(cwd = mill.api.BuildCtx.workspaceRoot).out.trim()
          val tagsAtCommit = os.proc("git", "tag", "--points-at", targetCommit)
            .call(cwd = mill.api.BuildCtx.workspaceRoot).out.trim().linesIterator.toList
          val latestTag = tagsAtCommit
            .filter(_.startsWith("v"))
            .map(_.stripPrefix("v"))
            .sorted(using Ordering.String.reverse)
            .headOption
            .getOrElse(tag)
          s"$latestTag-$commitCount-$shortHash-SNAPSHOT"
        }
      case other =>
        s"$other-SNAPSHOT"
    }
  }

  final def scalaVersion = scala

  def scalacOptions = Seq(
    "-release",
    "17",
    "-Wunused:all",
    "-Xcheck-macros",
    "-explain",
    "-opt", // the scala 3 optimizer for libraries
  )
}

trait CommonTestModule extends ScalaModule, TestModule.ScalaTest, ScalafixModule, ScalafmtModule {
  def mvnDeps = Seq(
    mvn"org.scalatestplus::scalacheck-1-19::3.2.20.0",
  )

  override def scalaTestVersion = Task("3.2.20")
}

trait CommonScalaJSModule extends ScalaJSModule, PublishModule {
  def scalaJSVersion = scalaJS

  def moduleKind = Task {
    ModuleKind.ESModule
  }
}

trait CommonScalaNativeModule extends ScalaNativeModule, PublishModule, mill.api.DynamicModule {
  def scalaNativeVersion = scalaNative

  /** Nothing a Scala Native module produces runs on a JVM, so let it use whichever one Mill is
    * running on rather than making coursier fetch the pinned one. That pin has no Temurin build for
    * every platform we compile on -- musl is the one that bites.
    */
  override def javaHome = Task { None }

  override def moduleDirectChildren: Seq[mill.api.Module] =
    super.moduleDirectChildren.filterNot(_.moduleSegments.last.value == "scoverage")
}

/** Hides a module's nested `native` module unless [[nativeEnabled]].
  */
trait NativeOptional extends mill.api.DynamicModule {
  override def moduleDirectChildren: Seq[mill.api.Module] =
    if nativeEnabled then super.moduleDirectChildren
    else super.moduleDirectChildren.filterNot(_.moduleSegments.last.value == "native")
}

// Global coverage reporting
object coverage extends ScoverageReport {
  override def scalaVersion = scala

  override def scoverageVersion = "2.5.2"
}

/** Trait to disable BSP for shared-code platform modules to speed up IDEs
  */
trait NoBspModule extends CommonModule {
  override def enableBsp: Boolean = false
}

trait ResourcesAsStrings(module: String) extends JavaModule {
  override def generatedSources = Task {

    val maxStrConstLen = 64 * 1000
    val sb = new java.lang.StringBuilder

    sb.append("package eu.neverblink.linkml.").append(module).append("\n")
    sb.append("\n")
    sb.append("object Resources {\n")
    sb.append("  private def decodeBase64(value: String): String =\n")
    sb.append(
      "    new String(java.util.Base64.getDecoder.decode(value), java.nio.charset.StandardCharsets.UTF_8)\n",
    )
    sb.append("\n")
    sb.append("  val map = new java.util.HashMap[String, String]()\n")
    resources().filter(ref => os.exists(ref.path)).foreach { pathRef =>
      os.walk(pathRef.path, followLinks = true).sorted.foreach { path =>
        if (os.isFile(path)) {
          val relPath = "/" + path.relativeTo(pathRef.path).segments.mkString("/")
          sb.append("  map.put(\"").append(relPath).append("\", ")
          val encodedContent =
            java.util.Base64.getEncoder.encodeToString(os.read.bytes(path))
          val encodedContentLen = encodedContent.length
          if (encodedContentLen < maxStrConstLen)
            sb.append("decodeBase64(\"").append(encodedContent).append("\")")
          else {
            sb.append("decodeBase64(new java.lang.StringBuilder()")
            var offset = 0
            while (offset < encodedContentLen) {
              val len = Math.min(offset + maxStrConstLen, encodedContentLen)
              sb.append(".append(\"").append(encodedContent, offset, len).append("\")")
              offset += maxStrConstLen
            }
            sb.append(".toString)")
          }
          sb.append(")\n")
        }
      }
    }
    sb.append("\n")
    sb.append(
      "  def read(path: String): String = Option(map.get(path)).getOrElse(throw new NoSuchElementException(\"Resource not found: \" + path))\n",
    )
    sb.append("}\n")

    val dest = Task.dest / "eu" / "neverblink" / "linkml" / module / "Resources.scala"
    os.write.over(dest, sb.toString, createFolders = true)
    super.generatedSources() :+ PathRef(dest)
  }
}
