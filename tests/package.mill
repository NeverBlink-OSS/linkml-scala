package build.tests

import mill.*
import mill.javalib.Dep
import mill.scalalib.*
import millbuild.*
import com.carlosedp.aliases.*
import mill.api.Evaluator
import mill.scalajslib.TestScalaJSModule
import mill.scalanativelib.TestScalaNativeModule

object `package` extends Module, NativeOptional {
  def conformanceDefinitions: T[PathRef] = Task {
    PathRef(build.metamodel.definitionsRepo().path / "tests" / "conformance" / "model.yaml")
  }

  def regenerate(evaluator: Evaluator, args: String*) = Task.Command(exclusive = true) {
    AliasesModule.run(evaluator, "regenerateTests")
  }

  object jvm extends ResourcesAsStrings("tests"), CommonModule, CommonTestModule {
    def moduleDeps = Seq(
      build.schemaview.jvm,
    )
  }

  object js
      extends NoBspModule,
        ResourcesAsStrings("tests"),
        CommonScalaJsModule,
        TestScalaJSModule,
        CommonTestModule {
    def moduleDeps = Seq(
      build.schemaview.js,
    )
  }

  object native
      extends NoBspModule,
        ResourcesAsStrings("tests"),
        CommonScalaNativeModule,
        TestScalaNativeModule,
        CommonTestModule {
    override def mvnDeps: T[Seq[Dep]] = Task {
      super[TestScalaNativeModule].mvnDeps() ++ super[CommonTestModule].mvnDeps()
    }

    def moduleDeps = Seq(
      build.schemaview.native,
    )
  }
}
