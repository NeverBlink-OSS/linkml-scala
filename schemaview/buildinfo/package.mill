package build.schemaview.buildinfo

import mill.*
import millbuild.*

/** The build info model, generated into Scala by this project's own Scala generator. */
object `package` extends Module, NativeOptional, LinkMlModelModule {
  def modelGeneratorCli = build.cli.jvm.runner

  def modelSchema = Task { "model/build-info.yaml" }

  def modelPackage = "eu.neverblink.linkml.schemaview.buildinfo"

  // The npm package's index.d.ts uses this as the return type of `buildInfo`
  override def otherModelOutputs =
    Map("typescript" -> build.generator.moduleDir / "npm" / "build-info.d.ts")

  object jvm extends CommonModule {
    def moduleDeps = Seq(
      build.runtime.jvm,
    )
  }

  object js extends NoBspModule, CommonScalaJsModule {
    def moduleDeps = Seq(
      build.runtime.js,
    )
  }

  object native extends NoBspModule, CommonScalaNativeModule {
    def moduleDeps = Seq(
      build.runtime.native,
    )
  }
}
