package build.ohi.model.lock

import mill.*
import millbuild.*

/** The ohi lock file model, generated into Scala by this project's own Scala generator. */
object `package` extends Module, LinkMlModelModule {
  def modelGeneratorCli = build.cli.jvm.runner

  def modelSchema = Task { "model/ohi/lock.yaml" }

  def modelPackage = "eu.neverblink.ohi.model.generated.lock"

  override def otherModelOutputs = Seq(
    ModelOutput("pydantic", build.ohi.moduleDir / "python" / "src" / "ohi" / "generated_lock.py"),
    ModelOutput("typescript", build.ohi.moduleDir / "typescript" / "src" / "generated_lock.ts"),
  )

  object jvm extends CommonBuildModule {
    def moduleDeps = Seq(build.runtime.jvm)
  }
}
