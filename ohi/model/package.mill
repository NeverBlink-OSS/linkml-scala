      build.yaml.jvm,
      build.ohi.model.publication.jvm,
      build.ohi.model.searchrequest.jvm,
      build.ohi.model.search.jvm,
      build.ohi.model.config.jvm,
      build.ohi.model.error.jvm,
      build.ohi.model.lock.jvm,
      build.ohi.model.lockerror.jvm,
    )

    object test extends ScalaTests, CommonTestModule {
      override def mvnDeps = super.mvnDeps() ++ Seq(mvn"com.lihaoyi::ujson:4.4.3")
    }
  }
}
