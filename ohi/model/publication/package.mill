package build.ohi.model.publication

import mill.*
import millbuild.*

/** The ohi publication metadata model, generated into Scala by this project's own Scala generator. */
object `package` extends Module, LinkMlModelModule {
  def modelGeneratorCli = build.cli.jvm.runner

  def modelSchema = Task { "model/ohi/package.yaml" }

  def modelPackage = "eu.neverblink.ohi.model.generated"

  override def otherModelOutputs = Seq(
    ModelOutput("pydantic", build.ohi.moduleDir / "python" / "src" / "ohi" / "generated.py"),
    ModelOutput("typescript", build.ohi.moduleDir / "typescript" / "src" / "generated.ts"),
    // The Java SDK has all models in one package, so they come from one schema that imports all
    ModelOutput(
      "java --clean --package eu.neverblink.ohi.sdk",
      build.ohi.moduleDir / "java" / "src" / "eu" / "neverblink" / "ohi" / "sdk",
      Some("model/ohi/sdk.yaml"),
    ),
  )

  object jvm extends CommonBuildModule {
    def moduleDeps = Seq(build.runtime.jvm)
  }
}
