package build.ohi.java

import mill.*
import mill.javalib.*
import mill.javalib.publish.{Developer, License, PomSettings, VersionControl}
import millbuild.*

/** The Java SDK, `eu.neverblink.ohi:ohi-sdk`. It is plain Java, with Jackson 2 as its only
  * dependency. The model classes in it are generated by `./mill regenerate`.
  */
object `package` extends JavaModule, GitVersionPublishModule {
  def artifactName = "ohi-sdk"

  def javacOptions = Seq("--release", "17", "-Xlint:all", "-Werror", "-encoding", "UTF-8")

  def mvnDeps = Seq(mvn"com.fasterxml.jackson.core:jackson-databind:2.21.0")

  /** Since JDK 23, javadoc puts about 4 MB of web fonts into every javadoc jar. An input, as it
    * depends on the JDK that Mill runs on, which is not part of the cache key.
    */
  def javadocNoFonts = Task.Input {
    if sys.props("java.specification.version").toInt >= 23 then Seq("--no-fonts") else Seq.empty
  }

  def javadocOptions = Task { super.javadocOptions() ++ javadocNoFonts() }

  def pomSettings = PomSettings(
    description = "Search ontologies on ohi.dev, inspect their metadata and download their files.",
    organization = "eu.neverblink.ohi",
    url = "https://ohi.dev",
    licenses = Seq(License.`Apache-2.0`),
    versionControl = VersionControl.github("NeverBlink-OSS", "ohi"),
    Seq(
      Developer(
        id = "NeverBlink",
        name = "NeverBlink",
        url = "https://neverblink.eu",
        organization = Some("NeverBlink"),
        organizationUrl = Some("https://neverblink.eu"),
      ),
    ),
  )

  object test extends JavaTests, TestModule.Junit5 {
    def mvnDeps = Seq(mvn"org.junit.jupiter:junit-jupiter:5.11.3")

    def forkEnv = super.forkEnv() ++ Map("OHI_EXAMPLES" -> (build.ohi.moduleDir / "examples").toString)
  }
}
