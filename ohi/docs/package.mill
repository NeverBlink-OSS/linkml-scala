package build.ohi.docs

import mill.*
import mill.Module

object `package` extends Module {
  /** Run an npm script of the Ohi docs site (ohi/docs/package.json). Installs npm deps on first run.
   * Requires Node.js and npm on the PATH.
   */
  def runNpm(script: String): Unit = {
    if (!os.exists(moduleDir / "node_modules"))
      os.call(("npm", "ci"), cwd = moduleDir, stdout = os.Inherit, stderr = os.Inherit)
    os.call(("npm", "run", script), cwd = moduleDir, stdout = os.Inherit, stderr = os.Inherit)
  }

  /** Build the Ohi docs site from src/content/docs/ into ohi/docs/dist, to be served under
   * https://ohi.dev/docs/. Fails on a broken link between pages or to a heading.
   */
  def build(args: String*) = Task.Command(exclusive = true) {
    runNpm("build")
  }

  /** Serve the Ohi docs site at http://localhost:4321/docs/, reloading on every change. */
  def serve(args: String*) = Task.Command() {
    runNpm("dev")
  }

  /** Production preview: Build the Ohi docs site and serve the result at
   * http://localhost:4321/docs/. This is required for some functionality, like search.
   */
  def preview(args: String*) = Task.Command() {
    runNpm("build")
    runNpm("preview")
  }
}
