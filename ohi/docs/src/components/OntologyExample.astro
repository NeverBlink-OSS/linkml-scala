    align-items: start;
    gap: 0.5rem 0;
    padding-block: 0.5rem;
  }

  .ontology-node {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    text-align: center;
    color: var(--sl-color-white);
  }

  /* Agent sits in the middle column, under both */
  .ontology-node.agent {
    grid-column: 2;
  }

  .node-icon {
    display: grid;
    place-items: center;
    width: 4.5rem;
    height: 4.5rem;
    border-radius: 50%;
  }

  .node-icon svg {
    width: 2.75rem;
    height: 2.75rem;
  }

  svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .person {
    color: #17685d;
    background: #d9f1e8;
  }

  .agent-icon {
    color: #845000;
    background: #ffecb3;
  }

  .organization {
    color: #6652a3;
    background: #ece5ff;
  }

  .ontology-edge {
    display: flex;
    align-items: center;
    color: var(--sl-color-gray-2);
    font-size: 0.8125rem;
    white-space: nowrap;
  }

  /* A named relationship: a solid line that stretches, with the label above it */
  .relation {
    flex-direction: column;
    padding-top: 0.875rem;
  }

  .relation code {
    font-size: 0.8125rem;
  }

  .arrow {
    display: flex;
    align-items: center;
    width: 100%;
    height: 1.25rem;
  }

  /* The line takes whatever the column gives it, the head keeps its size */
  .arrow-line {
    flex: 1;
    border-top: 1.8px solid currentColor;
  }

  .arrow-head {
    flex: none;
    width: 0.625rem;
    height: 1.25rem;
  }

  /* Subclassing: two dashed curves bending in from the nodes above to Agent */
  .subclass-band {
    position: relative;
    grid-column: 1 / -1;
    height: 4rem;
    color: var(--sl-color-gray-2);
  }

  .connectors {
    width: 100%;
    height: 100%;
  }

  /* Left as it is drawn while the viewBox is stretched sideways */
  .connectors path {
    stroke-dasharray: 4 4;
    vector-effect: non-scaling-stroke;
  }

  /* Drawn apart from the curves, so stretching them cannot distort it */
  .connector-head {
    position: absolute;
    left: 50%;
    bottom: 0;
    width: 0.75rem;
    height: 0.625rem;
    transform: translateX(-50%);
  }

  /* Same background as the figure, so the curves pass behind the words */
  .subclass-label {
    position: absolute;
    top: 0.75rem;
    left: 50%;
    transform: translateX(-50%);
    padding-inline: 0.375rem;
    background: var(--sl-color-gray-7, var(--sl-color-gray-6));
    font-size: 0.8125rem;
    white-space: nowrap;
  }

  @media (max-width: 34rem) {
