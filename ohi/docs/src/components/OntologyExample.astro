      height: 1.875rem;
    }

    .ontology-node {
      font-size: 0.8125rem;
      gap: 0.5rem;
    }

    .ontology-edge,
    .subclass-label {
      font-size: 0.6875rem;
    }

    .relation code {
      font-size: 0.6875rem;
    }

