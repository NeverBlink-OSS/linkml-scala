---
// Adds a link for reporting a problem with the page next to Starlight's "Edit page" link. It
// opens the ohi.dev bug template on GitHub with the page's address filled in.
import Default from '@astrojs/starlight/components/EditLink.astro';
import { Icon } from '@astrojs/starlight/components';

const page = new URL(Astro.url.pathname, Astro.site).href;
const reportUrl = `https://github.com/NeverBlink-OSS/ohi/issues/new?${new URLSearchParams({ template: 'ohi-dev-bug.yml', page })}`;
---

<div class="page-links sl-flex print:hidden">
  <Default />
  <a href={reportUrl} class="sl-flex">
    <Icon name="comment" size="1.2em" />
    Report a problem
  </a>
</div>

<style>
  .page-links {
    gap: 0.75rem 1.5rem;
    flex-wrap: wrap;
  }
  a {
    gap: 0.5rem;
    align-items: center;
    text-decoration: none;
    color: var(--sl-color-gray-3);
  }
  a:hover {
    color: var(--sl-color-white);
  }
</style>
