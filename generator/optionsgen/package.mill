package build.generator.optionsgen

import com.goyeau.mill.scalafix.ScalafixModule
import mill.*
import mill.scalalib.*
import mill.scalalib.scalafmt.ScalafmtModule
import millbuild.*

/** Generates the code for processing `model/converter/all_converters.yaml` into APIs for CLI, C and
  * Python. Internal: not published, and only good enough for these options.
  */
object `package` extends ScalaModule, ScalafmtModule, ScalafixModule {
  def scalaVersion = Version.scala

  def scalacOptions = Seq("-Wunused:all")

  def moduleDeps = Seq(build.generator.jvm)

  override def mvnDeps = Seq(mvn"com.lihaoyi::ujson:4.4.3")

  /** Write the generated sources of the part named in `args`: `cli` for the command line options,
    * which `./mill regenerate` writes and formats, `bindings` for the C and Python bindings, which
    * `LINKML_NATIVE=1 ./mill nativelib.bindings` writes and formats, or `docs` for the converter
    * pages of the docs site and the tests of their examples, which `./mill regenerate` writes.
    */
  def generate(args: String*) = Task.Command {
    runner().run(mill.api.BuildCtx.workspaceRoot.toString +: args)
  }
}
