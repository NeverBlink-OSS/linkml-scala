package build.generator

import mill.*
import mill.javalib.Dep
import mill.scalalib.*
import millbuild.*
import com.carlosedp.aliases.*

object `package` extends Module, NativeOptional {
  object jvm extends CommonModule, GeneratorDeps {
    override def mvnDeps = super.mvnDeps() ++ Seq(
      mvn"com.lihaoyi::os-lib:0.11.8",
    )

    def moduleDeps = Seq(
      build.schemaview.jvm,
    )

    // Tests parse the generated RDF back and cross-validate it with rdf4j-shacl, so they compile
    // and run on JDK 25.
    object test extends ScalaTests, CommonTestModule {
      override def jvmVersion = "25"

      override def javaHome = build.jdk25.javaHome

      override def moduleDeps = super.moduleDeps ++ Seq(build.tests.jvm, build.cli.jvm)

      override def mvnDeps = super.mvnDeps() ++ Seq(
        mvn"org.eclipse.rdf4j:rdf4j-shacl:${v.rdf4j}",
        mvn"com.softwaremill.sttp.apispec::jsonschema-circe::0.11.10",
        mvn"com.networknt:json-schema-validator:3.0.7",
        mvn"org.sangria-graphql::sangria:4.2.19",
        mvn"org.scala-lang::scala3-compiler:${v.scala}",
      )

      /** Fetch the linkml-benchmark-schemas datasets used by `BenchmarkSchemaSpec`.
       */
      def benchmarkSchemas = Task(persistent = true) {
        if Task.offline then Task.fail("Can't fetch linkml-benchmark-schemas offline")
        val cloneDir = os.temp.dir()
        os.call(
          (
            "git",
            "clone",
            "--depth=1",
            "https://github.com/NeverBlink-labs/linkml-benchmark-schemas",
          ),
          cwd = cloneDir,
        )
        os.copy.over(cloneDir / "linkml-benchmark-schemas" / "benchmark_data", Task.dest)
        PathRef(Task.dest)
      }

      /** The npm project whose `validate.mjs` checks the generated ER diagrams against the real
       * Mermaid parser, used by `ErDiagramMermaidSpec`.
       */
      def mermaidDir = mill.api.BuildCtx.workspaceRoot / "generator" / "test" / "mermaid"

      /** Install the pinned Mermaid that `ErDiagramMermaidSpec` validates its output against.
       * Requires Node.js 18+ and npm on the PATH.
       */
      def mermaidValidator(args: String*) = Task.Command(exclusive = true) {
        if !os.exists(mermaidDir / "node_modules") then
          os.call(("npm", "ci"), cwd = mermaidDir, stdout = os.Inherit, stderr = os.Inherit)
      }

      /** Where `ossieRepo` puts the apache/ossie checkout. */
      def ossieDir = mill.api.BuildCtx.workspaceRoot / "generator" / "test" / "ossie-repo"

      /** Clone apache/ossie, so that `OssieIntegrationSpec` also checks the generated ontologies
       * with the upstream `validation/validate.py`.
       */
      def ossieRepo(args: String*) = Task.Command(exclusive = true) {
        if !os.exists(ossieDir) then
          os.call(
            ("git", "clone", "--depth=1", "https://github.com/apache/ossie", ossieDir),
            stdout = os.Inherit,
            stderr = os.Inherit,
          )
      }

      // Point BenchmarkSchemaSpec at the fetched datasets, so they are cloned before the tests run,
      // ErDiagramMermaidSpec at the Mermaid install prepared by `mermaidValidator`, and
      // OssieIntegrationSpec at the checkout prepared by `ossieRepo`.
      override def forkEnv = super.forkEnv() ++ Map(
        "LINKML_BENCHMARK_SCHEMAS" -> benchmarkSchemas().path.toString,
        "LINKML_MERMAID_VALIDATOR" -> mermaidDir.toString,
        "LINKML_OSSIE_REPO" -> ossieDir.toString,
      ) ++
        sys.env.view.filterKeys(Set("PATH", "CI")).toMap
    }
  }

  object js extends NoBspModule, CommonScalaJsModule, GeneratorDeps {
    def moduleDeps = Seq(
      build.schemaview.js,
    )

    // README and the TS usage sample; the .d.ts itself is generated.
    def npmMetadata = Task.Source(mill.api.BuildCtx.workspaceRoot / "generator" / "npm")

    def jsApiSource = Task.Source(
      mill.api.BuildCtx.workspaceRoot /
        "generator" / "src-js" / "eu" / "neverblink" / "linkml" / "js" / "LinkMlJsApi.scala",
    )

    def tsDefs = Task {
      val out = Task.dest / "index.d.ts"
      os.write(out, TsDefsGen(os.read(jsApiSource().path)))
      PathRef(out)
    }

    /** Assemble the npm-publishable `@neverblink/linkml` package. */
    def npmPackage = Task {
      val report = fullLinkJS()
      val dest = Task.dest
      val mainFile = report.publicModules.head.jsFileName

      os.list(report.dest.path)
        .filter(p => p.ext == "js" || p.ext == "map")
        .foreach(p => os.copy.into(p, dest))
      os.copy.into(npmMetadata().path / "README.md", dest)
      os.copy.into(tsDefs().path, dest)
      os.write(
        dest / "package.json",
        NpmPackage.packageJson(publishVersion(), pomSettings().description, mainFile),
      )
      PathRef(dest)
    }

    /** Pack and install the package, then run the README examples and type-check the usage sample
     * against it. Requires Node.js and npm on the PATH.
     */
    def verifyPackage(args: String*) = Task.Command {
      val pkg = npmPackage().path
      val script = npmMetadata().path / "verify-package.mjs"
      val usageSample = npmMetadata().path / "usage.test.ts"
      os.call(
        ("node", script.toString, pkg.toString, usageSample.toString),
        stdout = os.Inherit,
        stderr = os.Inherit,
      )
      ()
    }

    object test extends ScalaJSTests, CommonTestModule {
      override def moduleDeps = super.moduleDeps :+ build.tests.js

      override def mvnDeps = super.mvnDeps() ++ Seq(
        mvn"com.softwaremill.sttp.apispec::jsonschema-circe::0.11.10",
      )
    }
  }

  object native extends NoBspModule, CommonScalaNativeModule, GeneratorDeps {
    def moduleDeps = Seq(
      build.schemaview.native,
    )

    object test extends ScalaNativeTests, CommonTestModule {
      override def moduleDeps = super.moduleDeps :+ build.tests.native

      override def mvnDeps = super.mvnDeps() ++ Seq(
        mvn"com.softwaremill.sttp.apispec::jsonschema-circe::0.11.10",
      )
    }
  }

  trait GeneratorDeps extends CommonModule {
    override def mvnDeps = super.mvnDeps() ++ Seq(
      mvn"com.softwaremill.sttp.apispec::apispec-model::0.11.10",
      mvn"com.github.plokhotnyuk.jsoniter-scala::jsoniter-scala-macros::2.40.1",
    )

    // Same fastparse macro bug as in SchemaViewModule
    override def scalacOptions = super.scalacOptions().filterNot(_ == "-Xcheck-macros")
  }
}