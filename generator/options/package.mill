package build.generator.options

import mill.*
import millbuild.*

/** The options of the generators, generated into Scala by this project's own Scala generator. */
object `package` extends Module, NativeOptional, LinkMlModelModule {
  def modelGeneratorCli = build.cli.jvm.runner

  def modelSchema = Task { "model/converter/all_generators.yaml" }

  def modelPackage = "eu.neverblink.linkml.generator.options"

  // The functions trait and its return type. The generators don't implement it.
  override def unusedModelFiles = Seq("GeneratorFunctions.scala", "GeneratedFiles.scala")

  // The npm package ships these types, see `TsDefsGen.modelTypes`
  override def otherModelOutputs =
    Map(
      "typescript --optional-defaults" ->
        build.generator.moduleDir / "npm" / "generator-options.d.ts",
    )

  object jvm extends CommonModule {
    def moduleDeps = Seq(
      build.runtime.jvm,
    )
  }

  object js extends NoBspModule, CommonScalaJsModule {
    def moduleDeps = Seq(
      build.runtime.js,
    )
  }

  object native extends NoBspModule, CommonScalaNativeModule {
    def moduleDeps = Seq(
      build.runtime.native,
    )
  }
}
