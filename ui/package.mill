package build.ui

import mill.*
import mill.Module
import mill.javalib.Dep
import mill.scalalib.*
import millbuild.*
import com.carlosedp.aliases.*

import com.sun.net.httpserver.{Filter, HttpExchange, HttpHandler, HttpServer, SimpleFileServer}
import java.net.InetSocketAddress
import java.nio.charset.StandardCharsets


object `package` extends Module {
  /** Bundle the TypeScript playground UI (app.ts + CodeMirror, plus the generation worker) into
   * ui/dist via esbuild. Installs npm deps on first run. Requires Node.js and npm on the PATH.
   */
  def buildUiBundle(): Unit = {
    val uiDir = mill.api.BuildCtx.workspaceRoot / "ui"
    if (!os.exists(uiDir / "node_modules"))
      os.call(("npm", "ci"), cwd = uiDir, stdout = os.Inherit, stderr = os.Inherit)
    os.call(("npm", "run", "build"), cwd = uiDir, stdout = os.Inherit, stderr = os.Inherit)
  }

  def bundle(args: String*) = Task.Command(exclusive = true) {
    buildUiBundle()
  }

  /** Regenerate ui/linkml.d.ts (the LinkML API types the UI is checked against) from the Scala
   * facade. Run after changing LinkMlJsApi.scala.
   */
  def types(args: String*) = Task.Command(exclusive = true) {
    // The same as the package's index.d.ts, except that it takes the types generated from the
    // models straight from generator/npm
    os.write.over(
      mill.api.BuildCtx.workspaceRoot / "ui" / "linkml.d.ts",
      TsDefsGen(
        os.read(build.generator.js.jsApiSource().path),
        f => os.read(build.generator.js.npmMetadata().path / f),
        "../generator/npm/",
      ),
    )
  }

  /** Type-check the UI against the LinkML types and confirm it bundles, including the Scala.js
   * bundle (which must load in a browser). Requires Node.js and npm on the PATH.
   */
  def check(args: String*) = Task.Command(exclusive = true) {
    build.generator.js.fullLinkJS()
    val uiDir = mill.api.BuildCtx.workspaceRoot / "ui"
    if (!os.exists(uiDir / "node_modules"))
      os.call(("npm", "ci"), cwd = uiDir, stdout = os.Inherit, stderr = os.Inherit)
    os.call(("npm", "run", "typecheck"), cwd = uiDir, stdout = os.Inherit, stderr = os.Inherit)
    os.call(("npm", "run", "build"), cwd = uiDir, stdout = os.Inherit, stderr = os.Inherit)
  }

  /** The release the landing page shows install lines for: the latest `v*` tag, without the `v`. */
  private def releaseVersion(root: os.Path): Option[String] =
    try
      Some(
        os.proc("git", "describe", "--tags", "--abbrev=0", "--match", "v*")
          .call(cwd = root, stderr = os.Pipe).out.trim().stripPrefix("v"),
      )
    catch { case _: os.SubprocessException => None }

  /** pages/index.html with the release version filled into its install lines. */
  private def landingPage(root: os.Path, version: String): String =
    os.read(root / "pages" / "index.html").replace("__VERSION__", version)

  /** The deployed site apart from the landing page, as (path in the site, file or folder in the
   * repo).
   */
  private def siteFiles(root: os.Path): Seq[(String, os.Path)] = {
    val icons = Seq("favicon.svg", "favicon.ico", "apple-touch-icon.png", "neverblink-logo.svg")
    val playground = Seq("index.html", "styles.css", "fonts", "dist") ++ icons
    playground.map(f => s"playground/$f" -> root / "ui" / f) ++
      // The landing page uses the icons and the fonts too
      (icons :+ "fonts").map(f => f -> root / "ui" / f) :+
      ("docs" -> root / "website" / "dist")
  }

  /** Build the whole site, as it's deployed to https://linkml.ohi.dev/, into out/ui/site.dest.
   */
  def site(args: String*) = Task.Command(exclusive = true) {
    build.generator.js.fullLinkJS()
    buildUiBundle()
    build.website.runNpm("build")

    val root = mill.api.BuildCtx.workspaceRoot
    val version = releaseVersion(root).getOrElse(
      Task.fail("No v* tag to take the release version from. Fetch them with `git fetch --tags`."),
    )
    for ((path, source) <- siteFiles(root))
      os.copy(source, Task.dest / os.RelPath(path), createFolders = true)
    os.write(Task.dest / "index.html", landingPage(root, version))
    PathRef(Task.dest)
  }

  /** Serve the whole site as `site` builds it, at http://localhost:8000/.
   */
  def serve(args: String*) = Task.Command() {
    build.generator.js.fullLinkJS()
    buildUiBundle()
    build.website.runNpm("build")

    val root = mill.api.BuildCtx.workspaceRoot
    val version = releaseVersion(root).getOrElse("0.0.0-SNAPSHOT")

    def respond(exchange: HttpExchange, contentType: String, body: Array[Byte]): Unit = {
      exchange.getResponseHeaders.set("Content-Type", contentType)
      exchange.sendResponseHeaders(200, body.length)
      exchange.getResponseBody.write(body)
      exchange.close()
    }
    val contentTypes = Map(
      "html" -> "text/html; charset=utf-8",
      "css" -> "text/css; charset=utf-8",
      "svg" -> "image/svg+xml",
      "png" -> "image/png",
      "ico" -> "image/x-icon",
    )

    val (folders, files) = siteFiles(root).partition((_, source) => os.isDir(source))
    val fileAt = files.map((path, source) => s"/$path" -> source).toMap
    val singleFiles: HttpHandler = exchange => {
      val path = exchange.getRequestURI.getPath
      val wanted = if (path.endsWith("/")) path + "index.html" else path
      if (wanted == "/index.html")
        val page = landingPage(root, version).getBytes(StandardCharsets.UTF_8)
        respond(exchange, contentTypes("html"), page)
      else fileAt.get(wanted) match {
        case Some(file) =>
          val contentType = contentTypes.getOrElse(file.ext, "application/octet-stream")
          respond(exchange, contentType, os.read.bytes(file))
        // /playground, like GitHub Pages
        case None if fileAt.contains(s"$path/index.html") =>
          exchange.getResponseHeaders.set("Location", s"$path/")
          exchange.sendResponseHeaders(301, -1)
          exchange.close()
        case None =>
          exchange.sendResponseHeaders(404, -1)
          exchange.close()
      }
    }

    // `no-cache` makes the browser ask the server before it reuses a file, so a page reloaded after
    // a rebuild gets the new files. Without it, Safari can keep using an old styles.css for days.
    val noCache = Filter.beforeHandler(
      "Cache-Control: no-cache",
      exchange => exchange.getResponseHeaders.set("Cache-Control", "no-cache"),
    )
    val log = SimpleFileServer.createOutputFilter(System.out, SimpleFileServer.OutputLevel.INFO)

    val server = HttpServer.create(new InetSocketAddress(8000), 0)
    val handlers = ("/" -> singleFiles) +: folders.map((path, source) =>
      s"/$path" -> SimpleFileServer.createFileHandler(source.toNIO),
    )
    handlers.foreach { (path, handler) =>
      server.createContext(path, handler).getFilters.addAll(java.util.List.of(log, noCache))
    }

    try {
      server.start()
      println("\nSite up at http://localhost:8000/ (playground at /playground/, docs at /docs/)\n")
      Thread.sleep(Long.MaxValue)
    } finally {
      server.stop(0)
    }
  }
}
