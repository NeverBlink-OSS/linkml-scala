package build.ui

import mill.*
import mill.Module
import mill.javalib.Dep
import mill.scalalib.*
import millbuild.*
import com.carlosedp.aliases.*

import com.sun.net.httpserver.{Filter, HttpServer, SimpleFileServer}
import java.net.InetSocketAddress


object `package` extends Module {
  /** Bundle the TypeScript playground UI (app.ts + CodeMirror, plus the generation worker) into
   * ui/dist via esbuild. Installs npm deps on first run. Requires Node.js and npm on the PATH.
   */
  def buildUiBundle(): Unit = {
    val uiDir = mill.api.BuildCtx.workspaceRoot / "ui"
    if (!os.exists(uiDir / "node_modules"))
      os.call(("npm", "ci"), cwd = uiDir, stdout = os.Inherit, stderr = os.Inherit)
    os.call(("npm", "run", "build"), cwd = uiDir, stdout = os.Inherit, stderr = os.Inherit)
  }

  def bundle(args: String*) = Task.Command(exclusive = true) {
    buildUiBundle()
  }

  /** Regenerate ui/linkml.d.ts (the LinkML API types the UI is checked against) from the Scala
   * facade. Run after changing LinkMlJsApi.scala.
   */
  def types(args: String*) = Task.Command(exclusive = true) {
    // The same as the package's index.d.ts, except that it takes the types generated from the
    // models straight from generator/npm
    os.write.over(
      mill.api.BuildCtx.workspaceRoot / "ui" / "linkml.d.ts",
      TsDefsGen(os.read(build.generator.js.jsApiSource().path), "../generator/npm/"),
    )
  }

  /** Type-check the UI against the LinkML types and confirm it bundles, including the Scala.js
   * bundle (which must load in a browser). Requires Node.js and npm on the PATH.
   */
  def check(args: String*) = Task.Command(exclusive = true) {
    build.generator.js.fullLinkJS()
    val uiDir = mill.api.BuildCtx.workspaceRoot / "ui"
    if (!os.exists(uiDir / "node_modules"))
      os.call(("npm", "ci"), cwd = uiDir, stdout = os.Inherit, stderr = os.Inherit)
    os.call(("npm", "run", "typecheck"), cwd = uiDir, stdout = os.Inherit, stderr = os.Inherit)
    os.call(("npm", "run", "build"), cwd = uiDir, stdout = os.Inherit, stderr = os.Inherit)
  }

  def serve(args: String*) = Task.Command() {
    build.generator.js.fullLinkJS()
    buildUiBundle()
    // `no-cache` makes the browser ask the server before it reuses a file, so a page reloaded after
    // a rebuild gets the new files. Without it, Safari can keep using an old styles.css for days.
    val noCache = Filter.beforeHandler(
      "Cache-Control: no-cache",
      exchange => exchange.getResponseHeaders.set("Cache-Control", "no-cache"),
    )
    val server =
      HttpServer.create(
        new InetSocketAddress(8000),
        0,
        "/",
        SimpleFileServer.createFileHandler(mill.api.BuildCtx.workspaceRoot.toNIO),
        SimpleFileServer.createOutputFilter(System.out, SimpleFileServer.OutputLevel.INFO),
        noCache,
      )

    try {
      server.start()
      println("\nBrowser UI up at http://localhost:8000/ui/\n")
      Thread.sleep(Long.MaxValue)
    } finally {
      server.stop(0)
    }
  }
}